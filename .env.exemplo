# Copie para .env e preencha:  cp .env.exemplo .env
# Sem aspas e sem espaços. O .env NUNCA vai pro git.

# Token do bot (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Botão direito no servidor -> Copiar ID do servidor (precisa do Modo Desenvolvedor ligado)
GUILD_ID=

# Botão direito no canal dos alertas -> Copiar ID do canal
CANAL_ALERTAS_ID=

# Botão direito no seu nome -> Copiar ID do usuário
DONO_ID=
