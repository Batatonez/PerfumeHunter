# Unit do systemd do Scentinel.
# Não edite à mão: o ./instalar.sh gera dados/scentinel.service com o seu usuário e pasta.

[Unit]
Description=Scentinel (bot do Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USUARIO__
WorkingDirectory=__PASTA__
EnvironmentFile=__PASTA__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__PASTA__/.venv/bin/python -m scentinel
Restart=on-failure
RestartSec=30
# trava de segurança pra RAM (a máquina tem 3 GB e também roda o Minecraft)
MemoryMax=400M

[Install]
WantedBy=multi-user.target
